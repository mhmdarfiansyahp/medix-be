    end

    Web -->|HTTP/JSON| Router
    Router --> Auth
    Auth --> User
    Auth --> Medicine
    Auth --> Drug
    Auth --> Transaction
    Auth --> Report

    User --> PG
    Medicine --> PG
    Drug --> PG
    Transaction --> PG
    Report --> PG
    Migrate --> PG

    style Web fill:#e1f5fe
    style Router fill:#f3e5f5
